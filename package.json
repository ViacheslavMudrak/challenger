{
  "name": "challenger",
  "description": "Application utilizing Sitecore JavaScript Services and Next.js",
  "version": "21.5.2",
  "private": true,
  "config": {
    "appName": "challenger",
    "rootPlaceholders": [
      "jss-main"
    ],
    "sitecoreConfigPath": "/App_Config/Include/zzz",
    "graphQLEndpointPath": "/sitecore/api/graph/edge",
    "language": "en",
    "templates": [
      "nextjs",
      "nextjs-xmcloud",
      "nextjs-sxa",
      "nextjs-multisite"
    ]
  },
  "engines": {
    "node": ">=12",
    "npm": ">=6"
  },
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://jss.sitecore.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitecore/jss.git"
  },
  "bugs": {
    "url": "https://github.com/sitecore/jss/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@sitecore-cloudsdk/core": "^0.5.8",
    "@sitecore-cloudsdk/events": "^0.5.8",
    "@sitecore-cloudsdk/personalize": "^0.5.8",
    "@sitecore-content-sdk/cli": "^1.6.0",
    "@sitecore-content-sdk/nextjs": "^1.6.0",
    "@sitecore-feaas/clientside": "^0.6.4",
    "@sitecore-search/react": "^3.0.0",
    "@sitecore-search/ui": "^3.0.0",
    "@sitecore/components": "^1.1.10",
    "@sitecore/engage": "^1.4.1",
    "@uidotdev/usehooks": "^2.4.1",
    "bootstrap": "^5.1.3",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.3.2",
    "cookies-next": "^4.1.1",
    "dayjs": "^1.11.10",
    "dayjs-plugin-utc": "^0.1.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "flat": "^6.0.1",
    "font-awesome": "^4.7.0",
    "next": "^15.5.19",
    "next-images": "^1.8.5",
    "next-localization": "^0.12.0",
    "react": "^19.2.7",
    "react-currency-input-field": "^4.0.5",
    "react-dom": "^19.2.7",
    "sass": "^1.52.3",
    "sass-alias": "^1.0.5",
    "usehooks-ts": "^3.1.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@sitecore-jss/sitecore-jss-cli": "^22.12.4",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-jest": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-styling-webpack": "^1.0.1",
    "@storybook/blocks": "^8.6.14",
    "@storybook/nextjs": "8.6.14",
    "@storybook/react": "^8.6.14",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.7",
    "@types/node": "^18.19.50",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "autoprefixer": "^10.4.16",
    "chalk": "~4.1.2",
    "cheerio": "^1.1.2",
    "chokidar": "~3.5.3",
    "constant-case": "^3.0.4",
    "cross-env": "~7.0.3",
    "dotenv": "^16.0.3",
    "eslint": "^8.32.0",
    "eslint-config-next": "^13.1.5",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.32.1",
    "eslint-plugin-storybook": "^0.11.6",
    "eslint-plugin-yaml": "^0.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "npm-run-all": "~4.1.5",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "storybook": "^8.6.14",
    "tailwind-clip-path": "^1.0.0",
    "tailwindcss": "^3.3.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.2",
    "typescript": "~5.4.0",
    "yaml-loader": "^0.8.0"
  },
  "scripts": {
    "bootstrap": "ts-node --project tsconfig.scripts.json scripts/bootstrap.ts",
    "azbuild": "set AZUREDEVOPS=azurebuild& set GRAPH_QL_ENDPOINT=https://cm& npm-run-all --serial bootstrap next:build",
    "build": "npm-run-all --serial bootstrap next:build",
    "install-pre-push-hook": "ts-node --project tsconfig.scripts.json ./scripts/install-pre-push-hook.ts",
    "jss": "jss",
    "lint": "eslint ./src/**/*.tsx ./src/**/*.ts ./scripts/**/*.ts",
    "lint:fix": "eslint ./src/**/*.tsx ./src/**/*.ts ./scripts/**/*.ts --quiet --fix --ignore-path ../../.gitignore",
    "next:build": "next build",
    "next:dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "next:start": "next start",
    "scaffold": "ts-node --project tsconfig.scripts.json scripts/scaffold-component/index.ts",
    "start:connected": "npm-run-all --serial bootstrap --parallel next:dev start:watch-components",
    "start:production": "npm-run-all --serial bootstrap next:build next:start",
    "start:watch-components": "ts-node --project tsconfig.scripts.json scripts/generate-component-builder/index.ts --watch",
    "storybook": "npm-run-all --serial generatecomponentbuilder storybook:start",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:prebuild": "npm run test:generate-output",
    "generatecomponentbuilder": "ts-node --project tsconfig.scripts.json scripts/generate-component-builder/index.ts",
    "generate:component-map": "node scripts/generate-component-map.mjs",
    "test": "jest --watch",
    "test:coverage": "jest --env=jsdom --watchAll=false --coverage",
    "test:generate-output": "jest --json --outputFile=.jest-test-results.json || true"
  },
  "overrides": {
    "@storybook/nextjs": {
      "sharp": "npm:dry-uninstall"
    }
  }
}
